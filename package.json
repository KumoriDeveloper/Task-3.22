{
  "name": "digital-business-card-api",
  "version": "1.0.0",
  "description": "Digital business card backend — NestJS + Prisma + GraphQL, with Apollo Sandbox and an admin panel",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run build && node dist/database/seed.cli.js",
    "db:setup": "npm run db:deploy && npm run db:seed",
    "vercel-build": "node scripts/vercel-build.js",
    "format": "prettier --write \"src/**/*.ts\" \"public/**/*.{html,css,js}\" \"scripts/**/*.js\" \"api/**/*.js\" \"*.md\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.2.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/graphql": "^13.2.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dataloader": "^2.2.3",
    "graphql": "^16.11.0",
    "prisma": "^6.16.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prettier": "^3.6.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.2"
  }
}
