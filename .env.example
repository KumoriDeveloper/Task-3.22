# Copy to .env for local development: cp .env.example .env
# With Docker Compose the API receives its own DATABASE_URL (host "db"), so this file
# is only needed when you run the app on the host (npm run start:dev).

# PostgreSQL (host port published by docker-compose.yml).
# On Vercel set this to the pooled/serverless URL (Neon, Supabase, ...).
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public"

# Direct PostgreSQL URL used only while applying migrations and seeding on Vercel.
# Leave it equal to DATABASE_URL locally. In production set the non-pooled string
# when DATABASE_URL goes through PgBouncer: migrations and the admin seed need it.
DIRECT_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public"

APP_PORT=3000

# JWT signing key for admin sessions (min. 16 characters, use a long random value)
JWT_SECRET="local-development-secret-change-me"
JWT_EXPIRES_IN=12h

# Admin panel credentials. Required: the account is created/updated from these values,
# so change the password and use unique production values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Portfolio Admin"

# Seed the portfolio content on start when the database is empty.
# On Vercel the seed runs during the build instead and boot seeding is disabled there.
SEED_PORTFOLIO=true

# Long-running processes sync the admin and seed on boot. The Vercel handler sets this
# to false automatically because the build already did the work.
SEED_ON_BOOT=true

# Developer tools that expose the API surface. Both default to false in production.
# Set to true only when you need Apollo Sandbox / schema introspection locally.
GRAPHQL_SANDBOX=false
GRAPHQL_INTROSPECTION=false

# Local SQL logging (safe to leave off in production)
PRISMA_LOG_QUERIES=false
